---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout
  title="Fialka — Downloads"
  lang="en"
  canonicalPath="/downloads"
  description="Download Fialka — free open-source APK for Android. Post-quantum end-to-end encrypted messenger via Tor. No account required, no Google services."
>
  <div id="scroll-progress" class="fixed top-0 left-0 right-0 h-1 z-[60] bg-gradient-to-r from-phantom to-phantom-light origin-left scale-x-0"></div>

  <nav class="fixed top-0 left-0 right-0 z-50 glass-strong">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href={base} class="flex items-center gap-3 group">
        <img src={`${base}icon-192.png`} alt="Fialka" class="w-8 h-8 rounded-lg transition-transform group-hover:scale-110" />
        <span class="text-xl font-bold font-['Syne_Variable']">Fial<span class="text-phantom-light">ka</span></span>
      </a>
      <div class="hidden md:flex items-center gap-6 text-sm text-text-secondary">
        <a href={base} class="hover:text-phantom-light transition-colors">Home</a>
        <a href={`${base}cryptography`} class="hover:text-phantom-light transition-colors">Cryptography</a>
        <a href={`${base}how-it-works`} class="hover:text-phantom-light transition-colors">How it Works</a>
        <a href={`${base}changelog`} class="hover:text-phantom-light transition-colors">Changelog</a>
        <div class="relative group">
                <button class="flex items-center gap-1 text-phantom-light font-semibold cursor-pointer">
                  Docs
                  <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-44 glass-strong rounded-xl border border-white/10 py-1.5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
                  <a href={`${base}security`} class="block px-4 py-2 text-sm text-text-secondary hover:text-phantom-light hover:bg-white/5 transition-colors">Security</a>
                  <a href={`${base}mailbox`} class="block px-4 py-2 text-sm text-text-secondary hover:text-phantom-light hover:bg-white/5 transition-colors">Mailbox</a>
                  <a href={`${base}platforms`} class="block px-4 py-2 text-sm text-text-secondary hover:text-phantom-light hover:bg-white/5 transition-colors">Platforms</a>
                  <a href={`${base}downloads`} class="block px-4 py-2 text-sm text-phantom-light font-semibold transition-colors">Downloads</a>
                  <a href={`${base}faq`} class="block px-4 py-2 text-sm text-text-secondary hover:text-phantom-light hover:bg-white/5 transition-colors">FAQ</a>
                </div>
              </div>
      </div>
      <div class="flex items-center gap-4">
        <button id="lang-toggle" class="text-sm px-3 py-1.5 rounded-lg border border-phantom/30 hover:border-phantom-light hover:text-phantom-light transition-all cursor-pointer"><span data-lang="fr">EN</span><span data-lang="en">FR</span></button>
        <a href="https://github.com/FialkaApp/Fialka-Android" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-2 px-4 py-2 bg-phantom hover:bg-phantom-light text-white text-sm font-medium rounded-xl transition-all hover:scale-105 glow-phantom">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub
        </a>
        <button id="mobile-menu-btn" class="md:hidden flex flex-col gap-1.5 p-2 cursor-pointer" aria-label="Menu">
          <span class="block w-6 h-0.5 bg-white transition-all duration-300"></span>
          <span class="block w-6 h-0.5 bg-white transition-all duration-300"></span>
          <span class="block w-6 h-0.5 bg-white transition-all duration-300"></span>
        </button>
      </div>
    </div>
    <!-- Mobile menu -->
    <div id="mobile-menu" class="md:hidden hidden glass-strong border-t border-white/5">
      <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col gap-3 text-sm">
        <a href={base} class="py-2 text-text-secondary hover:text-phantom-light transition-colors">Home</a>
        <a href={`${base}cryptography`} class="py-2 text-text-secondary hover:text-phantom-light transition-colors">Cryptography</a>
        <a href={`${base}how-it-works`} class="py-2 text-text-secondary hover:text-phantom-light transition-colors">How it Works</a>
        <a href={`${base}changelog`} class="py-2 text-text-secondary hover:text-phantom-light transition-colors">Changelog</a>
        <a href={`${base}security`} class="py-2 text-text-secondary hover:text-phantom-light transition-colors">Security</a>
        <a href={`${base}mailbox`} class="py-2 text-text-secondary hover:text-phantom-light transition-colors">Mailbox</a>
        <a href={`${base}platforms`} class="py-2 text-text-secondary hover:text-phantom-light transition-colors">Platforms</a>
        <a href={`${base}downloads`} class="py-2 text-phantom-light font-semibold transition-colors">Downloads</a>
        <a href={`${base}faq`} class="py-2 text-text-secondary hover:text-phantom-light transition-colors">FAQ</a>
        <a href="https://github.com/FialkaApp/Fialka-Android" target="_blank" rel="noopener noreferrer" class="py-2 text-phantom-light hover:text-phantom transition-colors flex items-center gap-2">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub
        </a>
      </div>
    </div>
  </nav>

  <section class="pt-32 pb-12 animated-gradient">
    <div class="max-w-3xl mx-auto px-6">
      <div class="inline-flex items-center gap-2 glass px-4 py-2 rounded-full text-sm text-phantom-light mb-6 border border-phantom/30">
        📦 v4.3.5-alpha
      </div>
      <h1 class="text-4xl md:text-5xl font-black font-['Syne_Variable'] mb-4">Get <span class="gradient-text">Fialka</span></h1>
      <p class="text-text-muted">Download the latest release — free, open source, no account required.</p>
    </div>
  </section>

  <article class="py-12 pb-24">
    <div class="max-w-3xl mx-auto px-6">

      <!-- Warning -->
      <div class="glass rounded-2xl p-5 border border-amber-500/20 mb-10">
        <p class="text-sm text-text-secondary">
          ⚠️ <strong class="text-white">Beta software:</strong> Fialka is currently in beta. Core cryptography is battle-hardened, but UI and features may change. By downloading you agree to the <a href={`${base}terms`} class="text-phantom-light hover:underline">Terms of Use</a>.
        </p>
      </div>

      <!-- Android download -->
      <section class="mb-10">
        <h2 class="docs-h2">🤖 Android</h2>
        <div class="glass rounded-2xl p-6 border border-phantom/20">
          <div class="flex items-start justify-between flex-wrap gap-4 mb-6">
            <div>
              <p class="text-text-muted text-xs mb-1">Latest stable beta</p>
              <p class="text-white font-bold text-xl">v4.3.5-alpha</p>
              <p class="text-text-muted text-xs mt-1">versionCode 14 · May 2026</p>
            </div>
            <div class="text-right">
              <p class="text-text-muted text-xs mb-1">Requirements</p>
              <p class="text-text-secondary text-sm">Android 8.0+ (API 26)</p>
              <p class="text-text-muted text-xs">arm64-v8a or x86_64</p>
            </div>
          </div>

          <a href="https://github.com/FialkaApp/Fialka-Android/releases/latest"
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-3 w-full justify-center px-6 py-4 rounded-xl bg-gradient-to-r from-phantom to-phantom-light text-white font-bold text-lg hover:opacity-90 transition-all group mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17v3a2 2 0 002 2h14a2 2 0 002-2v-3"/></svg>
            Download APK (GitHub Releases)
          </a>

          <div class="glass rounded-xl p-4 border border-phantom/20 text-xs space-y-2">
            <p class="text-text-muted font-semibold text-white">SHA-256 checksum (v4.3.5-alpha APK):</p>
            <code class="text-phantom-light font-mono break-all block">See GitHub Releases for the verified checksum of this build.</code>
            <p class="text-text-muted mt-2">Verify on Linux/macOS: <code class="text-green-300">sha256sum fialka-v4.3.5-alpha.apk</code></p>
            <p class="text-text-muted">Verify on Windows: <code class="text-green-300">certutil -hashfile fialka-v4.3.5-alpha.apk SHA256</code></p>
          </div>
        </div>
      </section>

      <!-- Installation steps -->
      <section class="mb-10">
        <h2 class="docs-h2">Install on Android</h2>
        <ol class="space-y-3 text-text-secondary text-sm">
          <li class="flex gap-3">
            <span class="text-phantom-light font-bold shrink-0">1.</span>
            <span>Download the APK from GitHub Releases.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-phantom-light font-bold shrink-0">2.</span>
            <span>On your Android device, go to <strong class="text-white">Settings → Security → Install unknown apps</strong> and allow installation from your file manager or browser.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-phantom-light font-bold shrink-0">3.</span>
            <span>Open the downloaded APK file and tap <strong class="text-white">Install</strong>.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-phantom-light font-bold shrink-0">4.</span>
            <span>On first launch, Fialka will generate your cryptographic identity (BIP-39 24-word seed). <strong class="text-white">Back up your seed phrase securely</strong> — it's the only way to restore your account.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-phantom-light font-bold shrink-0">5.</span>
            <span>Tor bootstrap takes ~30 seconds on first launch. Once connected, you're ready to share your Account ID with contacts.</span>
          </li>
        </ol>
      </section>

      <!-- Desktop -->
      <section class="mb-10">
        <h2 class="docs-h2">🖥️ Desktop (Windows)</h2>
        <div class="glass rounded-2xl p-6 border border-phantom/20">
          <div class="text-center py-6">
            <div class="text-5xl mb-4">🔜</div>
            <p class="text-white font-semibold text-lg mb-2">Coming Soon</p>
            <p class="text-text-secondary text-sm mb-4">The Windows desktop client is in development. It uses the same Fialka-Core (Rust) cryptographic backend and is byte-for-byte protocol-compatible with the Android app.</p>
            <a href="https://github.com/FialkaApp/Fialka-Android/releases" target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl glass border border-phantom/30 text-phantom-light hover:border-phantom-light transition-all text-sm">
              Watch for releases on GitHub →
            </a>
          </div>
        </div>
      </section>

      <!-- iOS -->
      <section class="mb-10">
        <h2 class="docs-h2">🍎 iOS</h2>
        <div class="glass rounded-2xl p-6 border border-phantom/20 text-center py-6">
          <div class="text-5xl mb-4">📋</div>
          <p class="text-white font-semibold text-lg mb-2">Planned</p>
          <p class="text-text-secondary text-sm">iOS support is on the roadmap. Fialka-Core already has a target for <code class="text-phantom-light">aarch64-apple-ios</code>. No timeline yet.</p>
        </div>
      </section>

      <!-- Build from source -->
      <section class="mb-10">
        <h2 class="docs-h2">Build from Source</h2>
        <p class="text-text-secondary text-sm mb-4">Fialka is fully open source under GPLv3. You can build and verify the APK yourself:</p>
        <div class="glass rounded-2xl p-4 border border-phantom/20 overflow-x-auto">
          <pre class="text-xs text-green-300 font-mono whitespace-pre">git clone https://github.com/FialkaApp/Fialka-Android
cd Fialka-Android
./gradlew assembleRelease</pre>
        </div>
        <p class="text-text-muted text-xs mt-3">Requires: Android SDK, NDK, Rust toolchain (for Fialka-Core). See <a href="https://github.com/FialkaApp/Fialka-Android/blob/main/README.md" target="_blank" rel="noopener noreferrer" class="text-phantom-light hover:underline">README.md</a> for full setup instructions.</p>
      </section>

      <!-- Fialka Mailbox (Self-hosted) -->
      <section class="mb-10">
        <h2 class="docs-h2">📬 Fialka Mailbox (Self-hosted)</h2>
        <div class="glass rounded-2xl p-6 border border-phantom/20">
          <p class="text-text-secondary text-sm mb-4">
            Deploy your own encrypted store-and-forward relay over Tor. Owner/member access control,
            7-day TTL, and onion key protection with TPM 2.0 or passphrase.
          </p>

          <div class="grid md:grid-cols-2 gap-4 mb-5">
            <a href="https://github.com/FialkaApp/fialka-mailbox/releases/latest" target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-gradient-to-r from-phantom to-phantom-light text-white font-semibold hover:opacity-90 transition-all">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17v3a2 2 0 002 2h14a2 2 0 002-2v-3"/></svg>
              Download Mailbox (Latest)
            </a>
            <a href={`${base}mailbox`}
              class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl glass border border-phantom/30 text-phantom-light hover:border-phantom-light transition-all">
              📖 Open Mailbox documentation
            </a>
          </div>

          <div class="glass rounded-xl p-4 border border-phantom/20 overflow-x-auto mb-3">
            <p class="text-text-muted text-xs mb-2">One-line installer (Linux / RPi):</p>
            <pre class="text-xs text-green-300 font-mono whitespace-pre">curl -fsSL https://raw.githubusercontent.com/FialkaApp/fialka-mailbox/main/deploy/install.sh | sudo bash</pre>
          </div>

          <p class="text-text-muted text-xs">
            Repository: <a href="https://github.com/FialkaApp/fialka-mailbox" target="_blank" rel="noopener noreferrer" class="text-phantom-light hover:underline">github.com/FialkaApp/fialka-mailbox</a>
          </p>
        </div>
      </section>

      <!-- Links -->
      <div class="glass rounded-2xl p-6 border border-phantom/20">
        <h3 class="text-white font-bold mb-4">Related</h3>
        <div class="grid md:grid-cols-2 gap-3">
          {[
            { href: `${base}security`, label: '🔐 Security Policy', desc: 'Cryptographic algorithms and reporting' },
            { href: `${base}platforms`, label: '🦀 Platform Support', desc: 'Fialka-Core targets and bridges' },
            { href: `${base}changelog`, label: '📋 Changelog', desc: 'What changed in each version' },
            { href: 'https://github.com/FialkaApp/Fialka-Android', label: '💻 Source Code', desc: 'Full source on GitHub' },
          ].map(({ href, label, desc }) => (
            <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="glass rounded-xl p-4 border border-phantom/20 hover:border-phantom-light transition-all">
              <p class="text-white text-sm font-semibold">{label}</p>
              <p class="text-text-muted text-xs mt-1">{desc}</p>
            </a>
          ))}
        </div>
      </div>

    </div>
  </article>

  <script>
    const el = document.getElementById('scroll-progress');
    if (el) {
      window.addEventListener('scroll', () => {
        const h = document.documentElement.scrollHeight - window.innerHeight;
        el.style.transform = `scaleX(${h > 0 ? window.scrollY / h : 0})`;
      }, { passive: true });
    }

    // Mobile Menu Toggle
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    mobileMenuBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });

    // Language Toggle
    const langToggle = document.getElementById('lang-toggle');
    function applyLang(lang: string) {
      document.documentElement.classList.toggle('lang-fr', lang === 'fr');
      document.documentElement.classList.toggle('lang-en', lang === 'en');
      try { localStorage.setItem('fialka-lang', lang); } catch {}
    }
    const saved = (() => { try { return localStorage.getItem('fialka-lang'); } catch { return null; } })();
    applyLang(saved === 'en' ? 'en' : 'fr');
    langToggle?.addEventListener('click', () => {
      const cur = document.documentElement.classList.contains('lang-en') ? 'en' : 'fr';
      applyLang(cur === 'fr' ? 'en' : 'fr');
    });
  </script>

  <style>
    .docs-h2 { font-family: 'Syne Variable', system-ui, sans-serif; font-size: 1.4rem; font-weight: 700; color: #fff; margin-top: 0; margin-bottom: 1rem; }
  </style>
</Layout>