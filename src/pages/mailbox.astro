---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout
  title="Fialka — Mailbox"
  lang="en"
  canonicalPath="/mailbox"
  description="Fialka Mailbox — encrypted offline message relay. 4 modes: Direct P2P, Personal, Private Node, Public Node. Zero plaintext, self-hostable, open-source."
>
  <div id="scroll-progress" class="fixed top-0 left-0 right-0 h-1 z-[60] bg-gradient-to-r from-phantom to-phantom-light origin-left scale-x-0"></div>

  <nav class="fixed top-0 left-0 right-0 z-50 glass-strong">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href={base} class="flex items-center gap-3 group">
        <img src={`${base}icon-192.png`} alt="Fialka" class="w-8 h-8 rounded-lg transition-transform group-hover:scale-110" />
        <span class="text-xl font-bold font-['Syne_Variable']">Fial<span class="text-phantom-light">ka</span></span>
      </a>
      <div class="hidden md:flex items-center gap-6 text-sm text-text-secondary">
        <a href={base} class="hover:text-phantom-light transition-colors">Home</a>
        <a href={`${base}cryptography`} class="hover:text-phantom-light transition-colors">Cryptography</a>
        <a href={`${base}how-it-works`} class="hover:text-phantom-light transition-colors">How it Works</a>
        <a href={`${base}changelog`} class="hover:text-phantom-light transition-colors">Changelog</a>
        <div class="relative group">
                <button class="flex items-center gap-1 text-phantom-light font-semibold cursor-pointer">
                  Docs
                  <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-44 glass-strong rounded-xl border border-white/10 py-1.5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
                  <a href={`${base}security`} class="block px-4 py-2 text-sm text-text-secondary hover:text-phantom-light hover:bg-white/5 transition-colors">Security</a>
                  <a href={`${base}mailbox`} class="block px-4 py-2 text-sm text-phantom-light font-semibold transition-colors">Mailbox</a>
                  <a href={`${base}platforms`} class="block px-4 py-2 text-sm text-text-secondary hover:text-phantom-light hover:bg-white/5 transition-colors">Platforms</a>
                  <a href={`${base}downloads`} class="block px-4 py-2 text-sm text-text-secondary hover:text-phantom-light hover:bg-white/5 transition-colors">Downloads</a>
                  <a href={`${base}faq`} class="block px-4 py-2 text-sm text-text-secondary hover:text-phantom-light hover:bg-white/5 transition-colors">FAQ</a>
                </div>
              </div>
      </div>
      <div class="flex items-center gap-4">
        <a href="https://github.com/FialkaApp/fialka-mailbox" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-2 px-4 py-2 bg-phantom hover:bg-phantom-light text-white text-sm font-medium rounded-xl transition-all hover:scale-105 glow-phantom">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          Mailbox GitHub
        </a>
        <button id="mobile-menu-btn" class="md:hidden flex flex-col gap-1.5 p-2 cursor-pointer" aria-label="Menu">
          <span class="block w-6 h-0.5 bg-white transition-all duration-300"></span>
          <span class="block w-6 h-0.5 bg-white transition-all duration-300"></span>
          <span class="block w-6 h-0.5 bg-white transition-all duration-300"></span>
        </button>
      </div>
    </div>
    <!-- Mobile menu -->
    <div id="mobile-menu" class="md:hidden hidden glass-strong border-t border-white/5">
      <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col gap-3 text-sm">
        <a href={base} class="py-2 text-text-secondary hover:text-phantom-light transition-colors">Home</a>
        <a href={`${base}cryptography`} class="py-2 text-text-secondary hover:text-phantom-light transition-colors">Cryptography</a>
        <a href={`${base}how-it-works`} class="py-2 text-text-secondary hover:text-phantom-light transition-colors">How it Works</a>
        <a href={`${base}changelog`} class="py-2 text-text-secondary hover:text-phantom-light transition-colors">Changelog</a>
        <a href={`${base}security`} class="py-2 text-text-secondary hover:text-phantom-light transition-colors">Security</a>
        <a href={`${base}mailbox`} class="py-2 text-phantom-light font-semibold transition-colors">Mailbox</a>
        <a href={`${base}platforms`} class="py-2 text-text-secondary hover:text-phantom-light transition-colors">Platforms</a>
        <a href={`${base}downloads`} class="py-2 text-text-secondary hover:text-phantom-light transition-colors">Downloads</a>
        <a href={`${base}faq`} class="py-2 text-text-secondary hover:text-phantom-light transition-colors">FAQ</a>
        <a href="https://github.com/FialkaApp/fialka-mailbox" target="_blank" rel="noopener noreferrer" class="py-2 text-phantom-light hover:text-phantom transition-colors flex items-center gap-2">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          Mailbox GitHub
        </a>
      </div>
    </div>
  </nav>

  <section class="pt-32 pb-12 animated-gradient">
    <div class="max-w-3xl mx-auto px-6">
      <div class="inline-flex items-center gap-2 glass px-4 py-2 rounded-full text-sm text-phantom-light mb-6 border border-phantom/30">
        📬 Self-hosted relay
      </div>
      <h1 class="text-4xl md:text-5xl font-black font-['Syne_Variable'] mb-4">Fialka <span class="gradient-text">Mailbox</span></h1>
      <p class="text-text-muted">Self-hosted encrypted store-and-forward over Tor — owner-controlled, zero server-side decryption.</p>
    </div>
  </section>

  <article class="py-12 pb-24">
    <div class="max-w-3xl mx-auto px-6">

      <!-- Self-hosted quick start -->
      <section class="mb-10">
        <h2 class="docs-h2">Self-hosted: Download & Install</h2>
        <div class="glass rounded-2xl p-6 border border-phantom/20">
          <p class="text-text-secondary text-sm mb-5">
            Run your own Mailbox server on Linux / Raspberry Pi / VPS. Choose key protection mode:
            <strong class="text-white">TPM 2.0</strong>, <strong class="text-white">Passphrase</strong>, or legacy plaintext.
          </p>

          <div class="grid sm:grid-cols-2 gap-3 mb-4">
            <a href="https://github.com/FialkaApp/fialka-mailbox/releases/latest" target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-gradient-to-r from-phantom to-phantom-light text-white font-semibold hover:opacity-90 transition-all">
              ⬇️ Download latest release
            </a>
            <a href="https://github.com/FialkaApp/fialka-mailbox" target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl glass border border-phantom/30 text-phantom-light hover:border-phantom-light transition-all">
              💻 View source code
            </a>
          </div>

          <div class="glass rounded-xl p-4 border border-phantom/20 overflow-x-auto">
            <p class="text-text-muted text-xs mb-2">One-line installer (Linux / RPi):</p>
            <pre class="text-xs text-green-300 font-mono whitespace-pre">curl -fsSL https://raw.githubusercontent.com/FialkaApp/fialka-mailbox/main/deploy/install.sh | sudo bash</pre>
          </div>

          <p class="text-text-muted text-xs mt-3">
            Docs: <a href="https://github.com/FialkaApp/fialka-mailbox#readme" target="_blank" rel="noopener noreferrer" class="text-phantom-light hover:underline">README</a>
            · Security policy: <a href="https://github.com/FialkaApp/fialka-mailbox/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer" class="text-phantom-light hover:underline">SECURITY.md</a>
          </p>
        </div>
      </section>

      <!-- Two modes -->
      <section class="mb-10">
        <h2 class="docs-h2">Two Mutually Exclusive Operating Modes</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div class="glass rounded-2xl p-6 border border-phantom/20">
            <div class="text-2xl mb-3">📱</div>
            <h3 class="text-white font-bold text-lg mb-2">User Mode</h3>
            <p class="text-text-secondary text-sm mb-3">The phone functions as a standard messaging client.</p>
            <ul class="text-text-muted text-xs space-y-1.5">
              <li class="flex gap-2"><span class="text-green-400">✓</span> Creates a Fialka account (BIP-39 seed)</li>
              <li class="flex gap-2"><span class="text-green-400">✓</span> Generates a deterministic .onion address</li>
              <li class="flex gap-2"><span class="text-green-400">✓</span> Sends and receives E2E encrypted P2P messages</li>
              <li class="flex gap-2"><span class="text-green-400">✓</span> Receives offline messages via a Mailbox</li>
              <li class="flex gap-2"><span class="text-amber-400">⚠</span> Only ONE User Mode per device</li>
            </ul>
          </div>
          <div class="glass rounded-2xl p-6 border border-phantom/20">
            <div class="text-2xl mb-3">🖥️</div>
            <h3 class="text-white font-bold text-lg mb-2">Mailbox Mode</h3>
            <p class="text-text-secondary text-sm mb-3">The phone becomes a storage and message transport service.</p>
            <ul class="text-text-muted text-xs space-y-1.5">
              <li class="flex gap-2"><span class="text-green-400">✓</span> Exposes a permanent .onion Hidden Service</li>
              <li class="flex gap-2"><span class="text-green-400">✓</span> Stores encrypted blobs (zero decryption)</li>
              <li class="flex gap-2"><span class="text-green-400">✓</span> Auto-purges after 7-day TTL</li>
              <li class="flex gap-2"><span class="text-red-400">✗</span> Cannot send or receive chat messages</li>
              <li class="flex gap-2"><span class="text-amber-400">⚠</span> Requires 2 devices to use alongside User Mode</li>
            </ul>
          </div>
        </div>
        <div class="glass rounded-xl p-4 border border-amber-500/20 mt-4 text-sm text-text-muted">
          <strong class="text-white">⚠️ Important constraint:</strong> User Mode and Mailbox Mode are mutually exclusive on the same device. You need 2 phones (or a spare phone / Raspberry Pi as the Mailbox).
        </div>
      </section>

      <!-- Sharing models -->
      <section class="mb-10">
        <h2 class="docs-h2">Three Sharing Models</h2>
        <div class="space-y-4">
          <div class="glass rounded-2xl p-6 border border-phantom/20">
            <div class="flex items-start gap-4">
              <span class="text-2xl">1️⃣</span>
              <div>
                <h3 class="text-white font-bold mb-1">Personal Mailbox</h3>
                <p class="text-text-secondary text-sm">Used solely by the owner's User-mode phone. Each user account has one Personal Mailbox. Accessible only by the owner — "my Mailbox for when I'm offline".</p>
              </div>
            </div>
          </div>
          <div class="glass rounded-2xl p-6 border border-phantom/20">
            <div class="flex items-start gap-4">
              <span class="text-2xl">2️⃣</span>
              <div>
                <h3 class="text-white font-bold mb-1">Private Mailbox (whitelist)</h3>
                <p class="text-text-secondary text-sm">Shared with a restricted group — family, friends, colleagues. The owner alone manages the whitelist and permissions. Only authorized users can deposit messages. Granular control: add/remove access anytime.</p>
              </div>
            </div>
          </div>
          <div class="glass rounded-2xl p-6 border border-phantom/20">
            <div class="flex items-start gap-4">
              <span class="text-2xl">3️⃣</span>
              <div>
                <h3 class="text-white font-bold mb-1">Public Mailbox</h3>
                <p class="text-text-secondary text-sm">Accepts messages from all Fialka users. No whitelist, no authentication. Useful for bots, open services, and community relays.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Delivery modes table -->
      <section class="mb-10">
        <h2 class="docs-h2">Delivery Modes & Privacy</h2>
        <div class="glass rounded-2xl overflow-hidden border border-phantom/20">
          <table class="w-full text-sm">
            <thead><tr class="border-b border-phantom/20 bg-phantom/5">
              <th class="text-left p-4 text-white">Mode</th>
              <th class="text-left p-4 text-white">Description</th>
              <th class="text-left p-4 text-white">Privacy</th>
            </tr></thead>
            <tbody class="divide-y divide-phantom/10">
              <tr><td class="p-4 text-text-secondary font-semibold">0 — Direct P2P</td><td class="p-4 text-text-muted text-sm">.onion to .onion directly</td><td class="p-4 text-yellow-300 text-sm">★★★★★</td></tr>
              <tr><td class="p-4 text-text-secondary font-semibold">1 — Personal</td><td class="p-4 text-text-muted text-sm">Your own device (old phone, RPi)</td><td class="p-4 text-yellow-300 text-sm">★★★★★</td></tr>
              <tr><td class="p-4 text-text-secondary font-semibold">2 — Private Node</td><td class="p-4 text-text-muted text-sm">Friend hosts for trusted group (whitelist)</td><td class="p-4 text-yellow-300 text-sm">★★★★☆</td></tr>
              <tr><td class="p-4 text-text-secondary font-semibold">3 — Public Node</td><td class="p-4 text-text-muted text-sm">Community volunteers, auto-selected (default)</td><td class="p-4 text-yellow-300 text-sm">★★★☆☆</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Security guarantees -->
      <section class="mb-10">
        <h2 class="docs-h2">Security Guarantees</h2>
        <div class="space-y-2">
          {[
            ['ZERO server-side decryption', 'Blobs are completely opaque to the Mailbox — it stores encrypted bytes it cannot read.'],
            ['Raw blob storage', 'No metadata extraction — no recipient, no timing, no actual size, no content type.'],
            ['7-day max TTL', 'All undelivered blobs are automatically purged after 7 days.'],
            ['Stats only', 'Mailbox only tracks cumulative counters (totalDeposited, totalFetched) — no message-level analytics.'],
            ['Adaptive polling', '10s base interval, 5s after messages received, 60s backoff on network error.'],
            ['Full UI configuration', 'Mode, TTL, whitelist — all configurable in Settings.'],
          ].map(([title, desc]) => (
            <div class="glass rounded-xl p-4 border border-green-500/20 flex items-start gap-3">
              <span class="text-green-400 mt-0.5 shrink-0">✅</span>
              <div>
                <span class="text-white font-semibold text-sm">{title}</span>
                <p class="text-text-muted text-sm mt-0.5">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Push notifications -->
      <section class="mb-10">
        <h2 class="docs-h2">Push Notifications (opt-in)</h2>
        <div class="glass rounded-2xl p-5 border border-phantom/20 overflow-x-auto">
          <pre class="text-xs text-phantom-light font-mono leading-relaxed whitespace-pre">Phone A → sendMessage() → Tor Hidden Service → Phone B
                                                  ↓ (if offline)
                                          Fialka Mailbox stores ciphertext
                                                  ↓
                                          UnifiedPush + ntfy.sh
                                                  ↓
                                          Phone B wakes up → connects to Mailbox
                                          → retrieves + decrypts messages
                                          "New message received"
                                          (ZERO content, ZERO metadata)</pre>
        </div>
        <p class="text-text-muted text-xs mt-3">UnifiedPush + ntfy.sh are used as a zero-content wake-up signal only. Push notifications carry no message content or sender metadata whatsoever.</p>
      </section>

      <!-- Real-world use case -->
      <section class="mb-10">
        <h2 class="docs-h2">Real-World Use Case</h2>
        <div class="glass rounded-2xl p-6 border border-phantom/20 space-y-3 text-sm text-text-secondary">
          <p>📱 <strong class="text-white">Your main phone</strong> runs User Mode — normal Fialka messaging.</p>
          <p>🔌 <strong class="text-white">Old spare phone or tablet</strong> stays plugged in permanently at home on power + WiFi — running Mailbox Mode.</p>
          <p>📬 While you're offline, contacts send you messages → stored as encrypted blobs in your home Mailbox.</p>
          <p>🔄 When you come back online, your main phone connects to the Mailbox and retrieves all pending messages.</p>
          <p class="text-text-muted text-xs pt-2">Configure via: <code class="text-phantom-light">Settings → Mailbox → Personal Mailbox → enter your Mailbox .onion address</code></p>
        </div>
      </section>

    </div>
  </article>

  <script>
    const el = document.getElementById('scroll-progress');
    if (el) {
      window.addEventListener('scroll', () => {
        const h = document.documentElement.scrollHeight - window.innerHeight;
        el.style.transform = `scaleX(${h > 0 ? window.scrollY / h : 0})`;
      }, { passive: true });
    }
  </script>

  <style>
    .docs-h2 { font-family: 'Syne Variable', system-ui, sans-serif; font-size: 1.4rem; font-weight: 700; color: #fff; margin-top: 0; margin-bottom: 1rem; }
  </style>
</Layout>
